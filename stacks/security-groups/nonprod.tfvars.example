name = "security-groups"
env  = "nonprod"

aws_region  = "ap-southeast-1"
aws_profile = ""

# From the network stack (import.tf / outputs once available).
vpc_id = "vpc-REPLACE_ME"

# Keep keys/CIDRs aligned with stacks/network private_subnets (NAT + PostgreSQL rules).
private_subnets = {
  a = {
    cidr_block = "10.x.x.x/24"
    az         = "ap-southeast-1a"
    name       = "REPLACE_ME-private-a"
  }
}

