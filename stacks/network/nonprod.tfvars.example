name = "network"
env  = "nonprod"

aws_region  = "ap-southeast-1"
aws_profile = ""

vpc_name             = ""
vpc_secondary_cidrs  = []
enable_dns_support   = true
enable_dns_hostnames = true

public_subnets = {
  a = {
    cidr_block = "10.x.x.x/24"
    az         = "ap-southeast-1a"
    name       = "REPLACE_ME-public-a"
  }
}

private_subnets = {
  a = {
    cidr_block = "10.x.x.x/24"
    az         = "ap-southeast-1a"
    name       = "REPLACE_ME-private-a"
  }
}
